    "/v1/merchants/apply": {
      "post": {
        "summary": "Apply as a merchant/issuer",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MerchantApply"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "OK"
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/assets": {
      "get": {
        "summary": "List eligible redeemable assets (?issuer=)",
