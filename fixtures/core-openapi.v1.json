{
  "openapi": "3.1.0",
  "info": {
    "title": "Unbound core API",
    "version": "1.0.0-draft",
    "description": "Testnet-only. Writes that need an on-chain action return a STATEFUL intent, never a fake immediate success. Errors: {\"error\":{\"code\",\"message\",\"requestId\"}}."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3001"
    }
  ],
