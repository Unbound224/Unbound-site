# NON-SECRET CONFIG ONLY - placeholder values, do not use production keys
APP_ENV=development
STELLAR_NETWORK=testnet
# Where the browser reaches unbound-core (public, safe to expose). unbound-core sends no CORS headers, so local dev
# goes through this site's same-origin proxy: the browser calls /core/*, Next forwards to CORE_PROXY_TARGET.
NEXT_PUBLIC_API_URL=/core
CORE_PROXY_TARGET=http://127.0.0.1:3001
# Store listings. The app is NOT in any store today: leave these unset. Official badges render only when a value is
# an https URL on apps.apple.com / play.google.com. Unset -> "Download for Android (beta APK)" + "iOS - coming soon".
# NEXT_PUBLIC_APP_STORE_URL=
# NEXT_PUBLIC_PLAY_STORE_URL=
